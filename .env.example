# URL del stream en vivo (Icecast/Shoutcast). Sin ella el reproductor
# sintetiza un pad de acordes con Web Audio API para la demo.
NEXT_PUBLIC_STREAM_URL=

# Notificación de formularios (opcional). Sin estas tres variables las
# peticiones solo se escriben en el log del servidor.
RESEND_API_KEY=
EMAIL_EQUIPO=
EMAIL_REMITENTE=
